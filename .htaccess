# Canonical host: redirect www to apex
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.intrasyncindustrial\.com$ [NC]
RewriteRule ^(.*)$ https://intrasyncindustrial.com/$1 [R=301,L]

# HTTPS: the site sits behind Sucuri, which may reach this server over plain
# HTTP, so %{HTTPS} is not reliable here (checking it can loop forever).
# Redirect only when Sucuri explicitly reports the visitor used http; if the
# header is absent, do nothing. Sucuri's "HTTPS only" setting is the primary fix.
RewriteCond %{HTTP:X-Forwarded-Proto} =http [NC]
RewriteRule ^(.*)$ https://intrasyncindustrial.com/$1 [R=301,L]

# Block access to hidden files and directories (except .well-known for SSL certificates)
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^\.|/\.) - [F,L]

# 301 redirects for unpublished blog posts and renamed assets
Redirect 301 /blog/flexible-payroll-manufacturing.html /blog/calculate-true-labor-costs.html
Redirect 301 /blog/prevailing-wage-compliance.html /blog/certified-payroll-davis-bacon.html
Redirect 301 /walters-wolf-whitepaper.html /architectural-precast-whitepaper.html
Redirect 301 /assets/whitepapers/walters-wolf-architectural-precast-whitepaper.pdf /assets/whitepapers/architectural-precast-whitepaper.pdf

# Keep internal repo files off the public site (strategy docs, build config).
# cPanel deploy copies the whole repo into public_html.
RedirectMatch 404 ^/(\.git|docs|src|node_modules|v1)(/|$)
<FilesMatch "\.(md|yml|yaml|lock)$|^(package(-lock)?\.json|tailwind\.config\.js)$">
    Require all denied
</FilesMatch>

# Security headers (Sucuri also sends the first two; these cover direct-to-origin hits)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    # CSS/JS links carry ?v=<content hash> (npm run build), so a long cache is safe
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
